#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
# socks5-proxy — SOCKS5 proxy launcher for Termux (Android)
#
# What this script does:
#   1. Asks the user which port to listen on (remembers the last one used)
#   2. Detects the device's LAN IP address so other devices can reach it
#   3. Generates a small Python SOCKS5 server and runs it in the background
#   4. Prints connection details and useful commands for the user
#
# Files managed by this script:
#   $PREFIX/etc/socks5-proxy/config            -> remembers the last port used
#   $PREFIX/etc/socks5-proxy/socks5_server.py  -> the generated Python server
#   $PREFIX/etc/socks5-proxy/pid               -> PID of the running proxy
# =============================================================================

# ----------------------------------------------------------------------------
# ANSI escape codes for colored terminal output
# ----------------------------------------------------------------------------
# $'...' syntax embeds real escape characters, so the colors work both with
# echo -e and with cat (e.g. the help text)
GREEN=$'\033[0;32m'   # green  — success messages / values
YELLOW=$'\033[1;33m'  # yellow — informational text
RED=$'\033[0;31m'     # red    — errors
BLUE=$'\033[0;34m'    # blue   — hints / examples
NC=$'\033[0m'         # no color — resets formatting back to default

# Current version of this tool (shown by `socks5-proxy --version`)
VERSION="1.0.0"

# ----------------------------------------------------------------------------
# Configuration paths
# $PREFIX is Termux's install root (e.g. /data/data/com.termux/files/usr),
# so the config lives system-wide under $PREFIX/etc, not in the home dir.
# ----------------------------------------------------------------------------
CONFIG_DIR="$PREFIX/etc/socks5-proxy"
CONFIG_FILE="$CONFIG_DIR/config"
PID_FILE="$CONFIG_DIR/pid"

# Ensure the config directory exists before writing into it
mkdir -p "$CONFIG_DIR"

# ----------------------------------------------------------------------------
# get_stored_port — read the port saved by a previous run (if any)
#
# Returns (via stdout): the stored port number, or "" if none is saved yet.
# ----------------------------------------------------------------------------
get_stored_port() {
    if [ -f "$CONFIG_FILE" ]; then
        # Parse the config file instead of sourcing it — a tampered or
        # malformed config can never execute arbitrary code this way.
        # (tr -d '\r' strips carriage returns from Windows-edited files.)
        sed -n 's/^PROXY_PORT=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored port
    fi
}

# ----------------------------------------------------------------------------
# get_stored_ip — read the saved listening IP (if any)
#
# Returns (via stdout): the stored IP, or "" if none is saved yet.
# ----------------------------------------------------------------------------
get_stored_ip() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^PROXY_IP=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored IP
    fi
}

# ----------------------------------------------------------------------------
# get_stored_user — read the saved auth username (if any)
#
# Returns (via stdout): the stored username, or "" if none is saved yet.
# Authentication is considered enabled when this is non-empty.
# ----------------------------------------------------------------------------
get_stored_user() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^PROXY_USER=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored user
    fi
}

# ----------------------------------------------------------------------------
# get_stored_pass — read the saved auth password (if any)
#
# Returns (via stdout): the stored password, or "" if none is saved yet.
# ----------------------------------------------------------------------------
get_stored_pass() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^PROXY_PASS=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored password
    fi
}

# ----------------------------------------------------------------------------
# remove_config — delete a key=value line from the config file
#   Args: $1 = key to remove
# ----------------------------------------------------------------------------
remove_config() {
    [ -f "$CONFIG_FILE" ] || return 0
    grep -v "^$1=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
}

# ----------------------------------------------------------------------------
# save_config — update a single key=value line in the config file, keeping
#   any other settings intact
#   Args: $1 = key, $2 = value
# ----------------------------------------------------------------------------
save_config() {
    local key="$1" value="$2"
    mkdir -p "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    # Keep every line except an existing entry for this key, then append
    grep -v "^$key=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
    echo "$key=$value" >> "$CONFIG_FILE.tmp"
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
    # The config can hold an auth password — keep it private to this user
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

# ----------------------------------------------------------------------------
# save_port — persist the chosen port so it can be reused next time
#   Args: $1 = the port number to remember
# ----------------------------------------------------------------------------
save_port() {
    save_config "PROXY_PORT" "$1"
}

# ----------------------------------------------------------------------------
# save_ip — persist the listening IP address
#   Args: $1 = the IP to bind to (e.g. 0.0.0.0 or a LAN address)
# ----------------------------------------------------------------------------
save_ip() {
    save_config "PROXY_IP" "$1"
}

# ----------------------------------------------------------------------------
# is_valid_port — check whether a value is a usable TCP port number
#   Args: $1 = the value to validate
#   Returns: 0 (valid) if it is a number in the range 1-65535, 1 otherwise
# ----------------------------------------------------------------------------
is_valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# ----------------------------------------------------------------------------
# is_valid_ip — check whether a value is a valid IP address
#   Args: $1 = the value to validate
#   Returns: 0 (valid) for a well-formed IPv4 address or IPv6 literal
# ----------------------------------------------------------------------------
is_valid_ip() {
    local ip="$1"
    # IPv6 literal (e.g. ::, ::1, fe80::1) — validate with Python's parser
    if [[ "$ip" == *:* ]]; then
        python3 -c "import socket,sys; socket.inet_pton(socket.AF_INET6, sys.argv[1])" "$ip" 2>/dev/null
        return $?
    fi
    [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    local IFS='.' octet
    for octet in $ip; do
        # 10# forces base-10 so leading zeros (e.g. 192.168.08.1) work
        [ "$((10#$octet))" -le 255 ] || return 1
    done
}

# ----------------------------------------------------------------------------
# get_port — choose the listening port
#
# Priority:
#   1. A valid port passed as the first argument (e.g. `socks5-proxy 9999`)
#   2. The port saved in the config file (used automatically, no prompt)
#   3. Interactive prompt on first run (default 1080)
# ----------------------------------------------------------------------------
get_port() {
    # The port saved by the previous run, if any
    local stored_port=$(get_stored_port)
    local prompt

    # Banner header
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}     SOCKS5 Proxy Server              ${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo -e ""

    # 1) A valid port on the command line wins and is saved, so the port can
    #    be changed without touching the config file
    if [ -n "${1:-}" ]; then
        if is_valid_port "$1"; then
            PORT="$1"
            echo -e "${YELLOW}Using port from command line: ${GREEN}$PORT${NC}"
            save_port "$PORT"
            return
        fi
        echo -e "${YELLOW}⚠️  Ignoring invalid port argument: '$1'${NC}"
    fi

    # 2) A saved port is reused automatically — no prompt on later runs
    if [ -n "$stored_port" ]; then
        if is_valid_port "$stored_port"; then
            PORT="$stored_port"
            echo -e "${YELLOW}📌 Using saved port: ${GREEN}$PORT${NC}"
            return
        fi
        # Corrupt saved port -> fall through and ask for a new one
        echo -e "${YELLOW}⚠️  Saved port '$stored_port' is invalid — please enter a new one:${NC}"
    fi

    # 3) First run -> ask for a port from scratch
    echo -e "${YELLOW}📝 Enter the port number you want to use:${NC}"
    echo -e "${BLUE}   (e.g., 1080 is the default SOCKS port)${NC}"
    prompt="Port [1080]: "

    # Keep asking until a valid port is given (Enter = use the default)
    while true; do
        read -p "$prompt" PORT
        if [ -z "$PORT" ]; then
            # Empty input -> default to the standard SOCKS port
            PORT=1080
            echo -e "${YELLOW}Using port: $PORT${NC}"
        fi
        if is_valid_port "$PORT"; then
            break   # valid input, proceed
        fi
        echo -e "${RED}❌ Invalid port: '$PORT' (must be a number from 1 to 65535)${NC}"
    done
    save_port "$PORT"
}

# ----------------------------------------------------------------------------
# get_android_ip — detect the device's IP address on the local network
#
# Tries several strategies in order of preference:
#   1. The wlan0 interface (most common Wi-Fi interface name)
#   2. The wlan1 interface (secondary Wi-Fi / hotspot)
#   3. Any 192.168.x.x address on any interface
#   4. Any 10.x.x.x address on any interface
#   5. The legacy `ifconfig` output as a last resort
#
# Returns (via stdout): the detected IP address.
# Exits the script with an error if nothing can be detected.
# ----------------------------------------------------------------------------
get_android_ip() {
    # Strategy 1: explicit wlan0 interface
    IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oP 'inet \K[0-9.]+' | head -1)
    # Strategy 2: explicit wlan1 interface
    if [ -z "$IP" ]; then
        IP=$(ip -4 addr show wlan1 2>/dev/null | grep -oP 'inet \K[0-9.]+' | head -1)
    fi
    # Strategy 3: any 192.168.x.x address on any interface
    if [ -z "$IP" ]; then
        IP=$(ip -4 addr 2>/dev/null | grep -oP 'inet \K192\.168\.[0-9]+\.[0-9]+' | head -1)
    fi
    # Strategy 4: any 10.x.x.x address on any interface
    if [ -z "$IP" ]; then
        IP=$(ip -4 addr 2>/dev/null | grep -oP 'inet \K10\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi
    # Strategy 5: legacy ifconfig output (older Android/Termux setups)
    if [ -z "$IP" ]; then
        IP=$(ifconfig 2>/dev/null | grep -oP 'inet addr:\K[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | grep -v '127.0.0.1' | head -1)
    fi
    # If every strategy failed, we cannot give the user a usable address
    if [ -z "$IP" ]; then
        echo -e "${RED}❌ Could not detect your Android IP!${NC}"
        echo -e "${YELLOW}Run: ${GREEN}ip -4 addr${NC}${YELLOW} and find your IP manually${NC}"
        exit 1
    fi
    echo "$IP"
}

# =============================================================================
# Command-line interface
# =============================================================================

usage() {
    cat <<EOF
${YELLOW}socks5-proxy${NC} — SOCKS5 proxy server for Termux

${GREEN}SYNOPSIS${NC}
    socks5-proxy [command] [args]

${GREEN}COMMANDS${NC}
    start                Start the proxy (uses the saved port and IP)
    stop                 Stop the running proxy
    status               Show running state + saved settings + live stats
    logs                 Show the proxy log (follows when running)
    set port <1-65535>   Save the listening port
    set ip <IP>          Save the listening IP (IPv4 or IPv6 literal)
                         0.0.0.0 / :: = all interfaces
    set auth <u> [pass]  Save a username/password (RFC 1929 auth)
                       (password omitted -> prompted hidden)
    unset auth           Disable authentication
    show config          Show the saved port, IP, and auth state
    help                 Show this help
    --version            Show the version

    <PORT>               Shortcut for start: use <PORT> and save it

    Authentication is OFF by default and only applies after restart.
    Credentials are stored in plaintext in the config file.

${GREEN}EXAMPLES${NC}
    socks5-proxy                  Start with the saved settings
    socks5-proxy 9999             Start on port 9999 (and save it)
    socks5-proxy set port 1080    Save port 1080
    socks5-proxy set ip 0.0.0.0   Listen on all interfaces (IPv4)
    socks5-proxy set ip ::        Listen on all interfaces (IPv4 + IPv6)
    socks5-proxy status           Check whether the proxy is running
    socks5-proxy logs             Watch live connections
    socks5-proxy stop             Stop the running proxy

${GREEN}FIRST RUN${NC}
    On the first run you are asked for a port (Enter uses the default 1080).
    The port and listening IP are saved to the config file, so later runs
    start immediately without any prompt.

${GREEN}FILES${NC}
    $CONFIG_DIR/config      saved port (PROXY_PORT) and IP (PROXY_IP)
    $CONFIG_DIR/pid         PID of the running proxy
    $CONFIG_DIR/proxy.log   proxy output (view with `logs`)
    $CONFIG_DIR/stats       live stats for `status` (uptime, connections)

${RED}SECURITY${NC}
    The proxy has no authentication and is open to anyone who can reach it.
    Only run it on networks you trust, and stop it when unused.
EOF
}

# ----------------------------------------------------------------------------
# stop_proxy — stop the running proxy using the PID file
#   Args: optional -q for quiet mode (used before starting a new instance)
# ----------------------------------------------------------------------------
stop_proxy() {
    local quiet=0
    [ "${1:-}" = "-q" ] && quiet=1

    if [ ! -f "$PID_FILE" ]; then
        [ "$quiet" -eq 1 ] || echo -e "${YELLOW}ℹ️  Proxy is not running (no PID file).${NC}"
        return 0
    fi

    local old_pid
    old_pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null \
        && grep -q "socks5_server.py" "/proc/$old_pid/cmdline" 2>/dev/null; then
        [ "$quiet" -eq 1 ] || echo -e "${YELLOW}⏹  Stopping proxy (PID $old_pid)...${NC}"
        kill "$old_pid" 2>/dev/null || true
        sleep 1   # give it a moment to release the port
        rm -f "$PID_FILE"
        [ "$quiet" -eq 1 ] || echo -e "${GREEN}✅ Proxy stopped.${NC}"
    elif [ -z "$old_pid" ] || ! kill -0 "$old_pid" 2>/dev/null; then
        # Process is gone or the PID file is garbage — safe to discard
        rm -f "$PID_FILE"
        [ "$quiet" -eq 1 ] || echo -e "${YELLOW}ℹ️  No running proxy found — removed stale PID file.${NC}"
    fi
    # Otherwise (process alive but identity unverifiable): keep the PID file
    # so we don't lose track of the running proxy.
}

# ----------------------------------------------------------------------------
# start_proxy — start the SOCKS5 proxy in the background
#   Args: optional port override (also saved)
# ----------------------------------------------------------------------------
start_proxy() {
    # 1) Choose the port (saved port is used automatically; the first argument
    #    can override it, e.g. `socks5-proxy 9999`)
    get_port "$1"

    # 2) Choose the bind IP (saved IP, or all interfaces by default)
    BIND_IP=$(get_stored_ip)
    if [ -z "$BIND_IP" ]; then
        BIND_IP="0.0.0.0"
    elif ! is_valid_ip "$BIND_IP"; then
        echo -e "${YELLOW}⚠️  Saved IP '$BIND_IP' is invalid — listening on all interfaces.${NC}"
        BIND_IP="0.0.0.0"
    fi

    echo -e ""
    echo -e "${YELLOW}⏳ Starting SOCKS5 proxy on $BIND_IP:$PORT...${NC}"

    # 3) Stop any leftover proxy from a previous session
    stop_proxy -q

# 4) Make sure Python is installed; install it via Termux's package manager
#    if it is missing.
if ! command -v python &> /dev/null; then
    echo -e "${YELLOW}📦 Installing Python...${NC}"
    pkg install python -y
fi

# 5) Generate the Python SOCKS5 server.
#    NOTE: the heredoc delimiter is quoted ('EOL'), so no variable expansion
#    happens — the script is written to disk exactly as shown below.
cat > "$CONFIG_DIR/socks5_server.py" << 'EOL'
#!/data/data/com.termux/files/usr/bin/python

# -----------------------------------------------------------------------------
# Minimal SOCKS5 (RFC 1928) proxy server with optional username/password
# authentication (RFC 1929).
#
# Protocol flow handled here:
#   1. Client greets us:  VER(0x05) NMETHODS ...METHODS          (handshake)
#   2. We pick an auth method: 0x00 (none) or 0x02 (user/password).
#      Auth is enabled only when the SOCKS5_USER environment variable is set.
#   3. If auth is required: the RFC 1929 VER ULEN UNAME PLEN PASSWD exchange
#   4. Client sends a request: VER CMD RSV ATYP ...ADDR... PORT
#   5. We connect to the requested target and relay traffic both ways
# -----------------------------------------------------------------------------

import os
import socket
import threading
import sys
import struct
import hmac
import time

# Listening port: taken from the command line, defaulting to 1080
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 1080
# Bind address: taken from the command line, defaulting to all interfaces
BIND_IP = sys.argv[2] if len(sys.argv) > 2 else '0.0.0.0'
# Relay chunk size: 64 KiB reduces syscall overhead and improves throughput
BUFFER_SIZE = 65536
# Requested kernel socket buffer size (Linux doubles the requested value)
SOCK_BUF_SIZE = 262144

# Optional RFC 1929 username/password authentication. Disabled by default:
# it only kicks in when SOCKS5_USER is set (the launcher provides it).
AUTH_USER = os.environ.get('SOCKS5_USER', '')
AUTH_PASS = os.environ.get('SOCKS5_PASS', '')
AUTH_REQUIRED = bool(AUTH_USER)

# Shared UDP socket used for UDP ASSOCIATE relay (created in main())
udp_sock = None

# Serializes authentication attempts so a failed login throttles the next
# one too (a fresh connection would otherwise be handled by a new thread
# and brute force would go unhindered)
auth_lock = threading.Lock()

# Live stats for the launcher's `status` command. The launcher passes a
# stats-file path via the SOCKS5_STATS environment variable; a background
# thread refreshes the file every couple of seconds.
STATS_FILE = os.environ.get('SOCKS5_STATS', '')
START_TIME = time.time()
_stats_lock = threading.Lock()
_active_conns = 0
_total_conns = 0


def stats_writer():
    """Periodically persist live connection stats for the launcher."""
    if not STATS_FILE:
        return
    while True:
        with _stats_lock:
            try:
                with open(STATS_FILE, 'w') as f:
                    f.write('START=%d\nACTIVE=%d\nTOTAL=%d\n' % (
                        int(START_TIME), _active_conns, _total_conns))
            except OSError:
                pass
        time.sleep(2)


def tune_socket(sock):
    """Apply performance tweaks to a connected socket."""
    try:
        # Disable Nagle's algorithm — lower latency for interactive traffic
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        # Larger kernel buffers — fewer stalls under load
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, SOCK_BUF_SIZE)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, SOCK_BUF_SIZE)
        # Detect dead peers instead of hanging forever
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    except OSError:
        pass   # unsupported option — keep the kernel default


def recv_exact(sock, n):
    """Read exactly n bytes from `sock`, looping until complete (or EOF).

    TCP has no message boundaries, so a single recv() may return fewer
    bytes than expected. Returns the bytes actually read (shorter than n
    if the peer closed the connection early).
    """
    data = b''
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            break   # connection closed before n bytes arrived
        data += chunk
    return data


def udp_relay(udp_sock, client_addr, tcp_sock):
    """Relay UDP datagrams for one client (RFC 1928 UDP ASSOCIATE).

    The client sends datagrams to our UDP socket, each prefixed with the
    SOCKS5 UDP header (RSV FRAG ATYP ADDR PORT). We forward the payload to
    the target and send replies back with the same header so the client
    knows which destination each reply came from.

    Runs on the client's own thread. A single shared UDP socket is used, so
    this is simplest with one client at a time (the typical phone case);
    datagrams from other clients are ignored.
    """
    target = None
    dest = None
    # The client's UDP socket often uses a different port than its TCP
    # connection, so match on IP and reply to the UDP source address.
    client_ip = client_addr[0]
    client_udp = None
    udp_sock.settimeout(1.0)     # wake up periodically to check TCP side
    tcp_sock.setblocking(False)
    try:
        while True:
            # Closing the TCP association tears the UDP relay down
            try:
                if tcp_sock.recv(1, socket.MSG_PEEK) == b'':
                    break
            except (BlockingIOError, OSError):
                pass
            try:
                data, src = udp_sock.recvfrom(65535)
            except socket.timeout:
                continue
            # Re-check the TCP association now that a datagram arrived:
            # the client may have closed it while we were blocked waiting
            try:
                if tcp_sock.recv(1, socket.MSG_PEEK) == b'':
                    break
            except (BlockingIOError, OSError):
                pass
            if src[0] != client_ip:
                continue   # datagram from another client — ignore
            if client_udp is None:
                client_udp = src   # remember where the client listens
            elif src != client_udp:
                continue   # datagram from an unexpected UDP socket
            if len(data) < 4 or data[2] != 0:
                continue   # FRAG != 0 (fragmentation) is unsupported
            atyp = data[3]
            try:
                if atyp == 0x01:   # IPv4
                    addr = socket.inet_ntoa(data[4:8])
                    reply_hdr = data[3:8]           # ATYP + IPv4 address
                    family = socket.AF_INET
                    off = 8
                elif atyp == 0x03:   # domain name
                    dlen = data[4]
                    addr = data[5:5 + dlen].decode('utf-8')
                    reply_hdr = data[3:5 + dlen]    # ATYP + len + name
                    family = socket.AF_INET
                    off = 5 + dlen
                elif atyp == 0x04:   # IPv6
                    addr = socket.inet_ntop(socket.AF_INET6, data[4:20])
                    reply_hdr = data[3:20]          # ATYP + IPv6 address
                    family = socket.AF_INET6
                    off = 20
                else:
                    continue   # unknown address type
                port = struct.unpack('>H', data[off:off + 2])[0]
                payload = data[off + 2:]
                # (Re)open the target socket when the destination changes
                if dest != (addr, port):
                    if target:
                        target.close()
                    target = socket.socket(family, socket.SOCK_DGRAM)
                    target.settimeout(0.5)
                    dest = (addr, port)
                target.sendto(payload, dest)
                # Forward any replies from the target back to the client
                while True:
                    try:
                        resp, _ = target.recvfrom(65535)
                    except socket.timeout:
                        break
                    udp_sock.sendto(
                        b'\x00\x00\x00' + reply_hdr + struct.pack('>H', port) + resp,
                        client_udp)
            except (OSError, ValueError, IndexError):
                continue   # malformed datagram — drop it
    except OSError:
        pass
    finally:
        if target:
            target.close()


def handle_client(client_socket):
    """Handle a single SOCKS5 client connection on its own thread."""
    global _active_conns
    try:
        # --- SOCKS5 handshake (client greeting) -----------------------------
        # First message: VER(1) NMETHODS(1) METHODS(NMETHODS) — max 257 bytes
        data = recv_exact(client_socket, 2)      # VER + NMETHODS
        if len(data) < 2 or data[0] != 0x05:
            client_socket.close()
            return
        nmethods = data[1]
        # Read the list of authentication methods the client offers
        methods = recv_exact(client_socket, nmethods)
        if len(methods) < nmethods:
            client_socket.close()
            return

        if AUTH_REQUIRED:
            # Only username/password (0x02) is acceptable when auth is on
            if 0x02 not in methods:
                client_socket.sendall(b'\x05\xff')   # no acceptable methods
                client_socket.close()
                return
            client_socket.sendall(b'\x05\x02')       # we require user/password

            # --- RFC 1929 username/password subnegotiation -------------------
            # The lock serializes attempts: on a failure we sleep while still
            # holding it, so the next client's login is forced to wait.
            auth_lock.acquire()
            try:
                auth = recv_exact(client_socket, 2)      # VER + ULEN
                if len(auth) < 2 or auth[0] != 0x01:
                    client_socket.close()
                    return
                ulen = auth[1]
                uname = recv_exact(client_socket, ulen)
                if len(uname) < ulen:
                    client_socket.close()
                    return
                plen = recv_exact(client_socket, 1)
                if len(plen) < 1:
                    client_socket.close()
                    return
                passwd = recv_exact(client_socket, plen[0])
                if len(passwd) < plen[0]:
                    client_socket.close()
                    return
                # Constant-time comparison prevents timing side-channels
                if hmac.compare_digest(uname, AUTH_USER.encode('utf-8')) \
                        and hmac.compare_digest(passwd, AUTH_PASS.encode('utf-8')):
                    client_socket.sendall(b'\x01\x00')   # success
                else:
                    client_socket.sendall(b'\x01\x01')   # failure
                    # Hold the lock during the sleep so the NEXT client's
                    # auth attempt is delayed too (global throttle)
                    time.sleep(2)
                    client_socket.close()
                    return
            finally:
                auth_lock.release()
        else:
            # No authentication (the default)
            client_socket.sendall(b'\x05\x00')

        # --- SOCKS5 request ------------------------------------------------
        # Second message: VER(1) CMD(1) RSV(1) ATYP(1) ADDR(4..255) PORT(2)
        header = recv_exact(client_socket, 4)    # VER + CMD + RSV + ATYP
        if len(header) < 4:
            client_socket.close()
            return

        ver = header[0]    # SOCKS version (should be 0x05)
        cmd = header[1]    # command: CONNECT / BIND / UDP ASSOCIATE
        atyp = header[3]   # address type: IPv4 / domain name / IPv6

        # CONNECT (0x01) and UDP ASSOCIATE (0x03) are supported; BIND (0x02)
        # is rejected with REP 0x07 (command not supported)
        if ver != 0x05 or cmd not in (0x01, 0x03):
            client_socket.sendall(b'\x05\x07\x00\x01\x00\x00\x00\x00\x00\x00')
            client_socket.close()
            return

        # Read the destination address + port according to ATYP
        if atyp == 0x01:    # IPv4 (4 bytes)
            addr = socket.inet_ntoa(recv_exact(client_socket, 4))
            port = struct.unpack('>H', recv_exact(client_socket, 2))[0]
            family = socket.AF_INET
        elif atyp == 0x03:  # Domain name (1 length byte + name)
            domain_len = recv_exact(client_socket, 1)[0]
            addr = recv_exact(client_socket, domain_len).decode('utf-8')
            port = struct.unpack('>H', recv_exact(client_socket, 2))[0]
            family = socket.AF_INET   # the hostname is resolved by connect()
        elif atyp == 0x04:  # IPv6 (16 bytes)
            addr = socket.inet_ntop(socket.AF_INET6, recv_exact(client_socket, 16))
            port = struct.unpack('>H', recv_exact(client_socket, 2))[0]
            family = socket.AF_INET6
        else:
            # Unknown address type -> drop the connection
            client_socket.close()
            return

        if cmd == 0x03:
            # --- UDP ASSOCIATE ------------------------------------------------
            # Tell the client where to send UDP datagrams: the same port, on
            # the address the client actually reached us through (so it works
            # even when listening on 0.0.0.0). Then relay until the client
            # closes the TCP association.
            try:
                bnd_ip = client_socket.getsockname()[0]
            except OSError:
                bnd_ip = BIND_IP
            if ':' in bnd_ip:
                response = b'\x05\x00\x00\x04' + socket.inet_pton(socket.AF_INET6, bnd_ip)
            else:
                response = b'\x05\x00\x00\x01' + socket.inet_aton(bnd_ip)
            response += struct.pack('>H', PORT)
            client_socket.sendall(response)
            udp_relay(udp_sock, client_socket.getpeername(), client_socket)
            return

        # --- Connect to the requested target --------------------------------
        try:
            target_socket = socket.socket(family, socket.SOCK_STREAM)
            target_socket.settimeout(30)          # timeout only the connect
            target_socket.connect((addr, port))   # establish the connection
            target_socket.settimeout(None)        # blocking once connected
            tune_socket(target_socket)            # latency + buffer tuning
        except Exception as e:
            # Send a failure reply (REP 0x01 = general failure) and give up
            client_socket.sendall(b'\x05\x01\x00\x01\x00\x00\x00\x00\x00\x00')
            client_socket.close()
            return

        # --- Success reply (REP 0x00 = succeeded) ---------------------------
        # BND.ADDR/BND.PORT are unused for CONNECT, so zeros are acceptable
        bind_addr = '0.0.0.0'
        bind_port = 0
        response = b'\x05\x00\x00\x01'
        response += socket.inet_aton(bind_addr)
        response += struct.pack('>H', bind_port)
        client_socket.sendall(response)

        # --- Bidirectional traffic relay ------------------------------------
        def forward(src, dst):
            """Copy data from `src` to `dst` until one side closes."""
            try:
                while True:
                    data = src.recv(BUFFER_SIZE)
                    if not data:
                        break   # remote side closed the connection
                    dst.sendall(data)   # sendall: never silently truncates
            except:
                pass            # connection reset / timeout — stop copying
            finally:
                # Close both sockets to tear down the tunnel
                src.close()
                dst.close()

        # Copy client -> target on a background thread, and target -> client
        # on this thread (the main loop keeps the connection alive).
        threading.Thread(target=forward, args=(client_socket, target_socket), daemon=True).start()
        forward(target_socket, client_socket)

    except Exception as e:
        pass   # any unexpected error: just drop this client
    finally:
        # Decrement the live-connection counter (protected by the stats lock)
        with _stats_lock:
            _active_conns -= 1
        client_socket.close()


def main():
    """Create the listening socket and serve clients forever."""
    global udp_sock, _active_conns, _total_conns
    # An IPv6 bind address (e.g. "::" for all interfaces) uses AF_INET6,
    # with dual-stack enabled when the kernel allows it
    if ':' in BIND_IP:
        server = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
        try:
            server.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        except OSError:
            pass   # dual-stack unsupported — IPv6 only
    else:
        server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    # Allow immediate rebinding after the proxy is killed/restarted
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    # Listen on the configured address (0.0.0.0 = all interfaces)
    server.bind((BIND_IP, PORT))
    server.listen(50)

    # UDP socket for the UDP ASSOCIATE relay (same port number as TCP)
    udp_sock = socket.socket(server.family, socket.SOCK_DGRAM)
    udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    udp_sock.bind((BIND_IP, PORT))

    print(f"SOCKS5 proxy running on {BIND_IP}:{PORT}")
    print("Ready for connections...")

    # Keep the launcher's `status` command up to date with live stats
    threading.Thread(target=stats_writer, daemon=True).start()

    # Accept loop: hand each incoming client to its own daemon thread
    while True:
        client, addr = server.accept()
        tune_socket(client)   # apply latency + buffer tuning to the peer
        print(f"Connection from {addr[0]}:{addr[1]}")
        with _stats_lock:
            _active_conns += 1
            _total_conns += 1
        threading.Thread(target=handle_client, args=(client,), daemon=True).start()


