#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
# socks5-proxy — SOCKS5 proxy launcher for Termux (Android)
#
# What this script does:
#   1. Asks the user which port to listen on (remembers the last one used)
#   2. Detects the device's LAN IP address so other devices can reach it
#   3. Generates a small Python SOCKS5 server and runs it in the background
#   4. Prints connection details and useful commands for the user
#
# Files managed by this script:
#   $PREFIX/etc/socks5-proxy/config            -> remembers the last port used
#   $PREFIX/etc/socks5-proxy/socks5_server.py  -> the generated Python server
#   $PREFIX/etc/socks5-proxy/pid               -> PID of the running proxy
# =============================================================================

# ----------------------------------------------------------------------------
# ANSI escape codes for colored terminal output
# ----------------------------------------------------------------------------
# $'...' syntax embeds real escape characters, so the colors work both with
# echo -e and with cat (e.g. the help text)
GREEN=$'\033[0;32m'   # green  — success messages / values
YELLOW=$'\033[1;33m'  # yellow — informational text
RED=$'\033[0;31m'     # red    — errors
BLUE=$'\033[0;34m'    # blue   — hints / examples
CYAN=$'\033[0;36m'    # cyan   — informational log lines (connections)
NC=$'\033[0m'         # no color — resets formatting back to default

# Current version of this tool (shown by `socks5-proxy --version`)
VERSION="1.2.0"

# ----------------------------------------------------------------------------
# Configuration paths
# $PREFIX is Termux's install root (e.g. /data/data/com.termux/files/usr),
# so the config lives system-wide under $PREFIX/etc, not in the home dir.
# ----------------------------------------------------------------------------
CONFIG_DIR="$PREFIX/etc/socks5-proxy"
CONFIG_FILE="$CONFIG_DIR/config"
PID_FILE="$CONFIG_DIR/pid"

# Ensure the config directory exists before writing into it
mkdir -p "$CONFIG_DIR"

# ----------------------------------------------------------------------------
# get_stored_port — read the port saved by a previous run (if any)
#
# Returns (via stdout): the stored port number, or "" if none is saved yet.
# ----------------------------------------------------------------------------
get_stored_port() {
    if [ -f "$CONFIG_FILE" ]; then
        # Parse the config file instead of sourcing it — a tampered or
        # malformed config can never execute arbitrary code this way.
        # (tr -d '\r' strips carriage returns from Windows-edited files.)
        sed -n 's/^PROXY_PORT=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored port
    fi
}

# ----------------------------------------------------------------------------
# get_stored_ip — read the saved listening IP (if any)
#
# Returns (via stdout): the stored IP, or "" if none is saved yet.
# ----------------------------------------------------------------------------
get_stored_ip() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^PROXY_IP=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored IP
    fi
}

# ----------------------------------------------------------------------------
# get_stored_user — read the saved auth username (if any)
#
# Returns (via stdout): the stored username, or "" if none is saved yet.
# Authentication is considered enabled when this is non-empty.
# ----------------------------------------------------------------------------
get_stored_user() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^PROXY_USER=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored user
    fi
}

# ----------------------------------------------------------------------------
# get_stored_pass — read the saved auth password (if any)
#
# Returns (via stdout): the stored password, or "" if none is saved yet.
# ----------------------------------------------------------------------------
get_stored_pass() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^PROXY_PASS=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> no stored password
    fi
}

# ----------------------------------------------------------------------------
# get_stored_idle — read the saved idle timeout in seconds (if any)
# ----------------------------------------------------------------------------
get_stored_idle() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^IDLE_TIMEOUT=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> default is used
    fi
}

# ----------------------------------------------------------------------------
# get_stored_maxconns — read the saved max simultaneous connections (if any)
# ----------------------------------------------------------------------------
get_stored_maxconns() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^MAX_CONNS=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> default is used
    fi
}

# ----------------------------------------------------------------------------
# get_stored_loglevel — read the saved log verbosity (debug/info/warning/error)
# ----------------------------------------------------------------------------
get_stored_loglevel() {
    if [ -f "$CONFIG_FILE" ]; then
        sed -n 's/^LOG_LEVEL=//p' "$CONFIG_FILE" | tr -d '\r' | head -1
    else
        echo ""   # no config file yet -> default (warning) is used
    fi
}

# ----------------------------------------------------------------------------
# remove_config — delete a key=value line from the config file
#   Args: $1 = key to remove
# ----------------------------------------------------------------------------
remove_config() {
    [ -f "$CONFIG_FILE" ] || return 0
    grep -v "^$1=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
}

# ----------------------------------------------------------------------------
# save_config — update a single key=value line in the config file, keeping
#   any other settings intact
#   Args: $1 = key, $2 = value
# ----------------------------------------------------------------------------
save_config() {
    local key="$1" value="$2"
    mkdir -p "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    # Keep every line except an existing entry for this key, then append
    grep -v "^$key=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
    echo "$key=$value" >> "$CONFIG_FILE.tmp"
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
    # The config can hold an auth password — keep it private to this user
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

# ----------------------------------------------------------------------------
# save_port — persist the chosen port so it can be reused next time
#   Args: $1 = the port number to remember
# ----------------------------------------------------------------------------
save_port() {
    save_config "PROXY_PORT" "$1"
}

# ----------------------------------------------------------------------------
# save_ip — persist the listening IP address
#   Args: $1 = the IP to bind to (e.g. 0.0.0.0 or a LAN address)
# ----------------------------------------------------------------------------
save_ip() {
    save_config "PROXY_IP" "$1"
}

# ----------------------------------------------------------------------------
# is_valid_port — check whether a value is a usable TCP port number
#   Args: $1 = the value to validate
#   Returns: 0 (valid) if it is a number in the range 1-65535, 1 otherwise
# ----------------------------------------------------------------------------
is_valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# ----------------------------------------------------------------------------
# is_valid_ip — check whether a value is a valid IP address
#   Args: $1 = the value to validate
#   Returns: 0 (valid) for a well-formed IPv4 address or IPv6 literal
# ----------------------------------------------------------------------------
is_valid_ip() {
    local ip="$1"
    # IPv6 literal (e.g. ::, ::1, fe80::1) — validate with Python's parser
    if [[ "$ip" == *:* ]]; then
        python3 -c "import socket,sys; socket.inet_pton(socket.AF_INET6, sys.argv[1])" "$ip" 2>/dev/null
        return $?
    fi
    [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    local IFS='.' octet
    for octet in $ip; do
        # 10# forces base-10 so leading zeros (e.g. 192.168.08.1) work
        [ "$((10#$octet))" -le 255 ] || return 1
    done
}

# ----------------------------------------------------------------------------
# get_port — choose the listening port
#
# Priority:
#   1. A valid port passed as the first argument (e.g. `socks5-proxy 9999`)
#   2. The port saved in the config file (used automatically, no prompt)
#   3. Interactive prompt on first run (default 1080)
# ----------------------------------------------------------------------------
get_port() {
    # The port saved by the previous run, if any
    local stored_port=$(get_stored_port)
    local prompt

    # Banner header
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}     SOCKS5 Proxy Server              ${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo -e ""

    # 1) A valid port on the command line wins and is saved, so the port can
    #    be changed without touching the config file
    if [ -n "${1:-}" ]; then
        if is_valid_port "$1"; then
            PORT="$1"
            echo -e "${YELLOW}Using port from command line: ${GREEN}$PORT${NC}"
            save_port "$PORT"
            return
        fi
        echo -e "${YELLOW}⚠️  Ignoring invalid port argument: '$1'${NC}"
    fi

    # 2) A saved port is reused automatically — no prompt on later runs
    if [ -n "$stored_port" ]; then
        if is_valid_port "$stored_port"; then
            PORT="$stored_port"
            echo -e "${YELLOW}📌 Using saved port: ${GREEN}$PORT${NC}"
            return
        fi
        # Corrupt saved port -> fall through and ask for a new one
        echo -e "${YELLOW}⚠️  Saved port '$stored_port' is invalid — please enter a new one:${NC}"
    fi

    # 3) First run -> ask for a port from scratch
    echo -e "${YELLOW}📝 Enter the port number you want to use:${NC}"
    echo -e "${BLUE}   (e.g., 1080 is the default SOCKS port)${NC}"
    prompt="Port [1080]: "

    # Keep asking until a valid port is given (Enter = use the default)
    while true; do
        read -p "$prompt" PORT
        if [ -z "$PORT" ]; then
            # Empty input -> default to the standard SOCKS port
            PORT=1080
            echo -e "${YELLOW}Using port: $PORT${NC}"
        fi
        if is_valid_port "$PORT"; then
            break   # valid input, proceed
        fi
        echo -e "${RED}❌ Invalid port: '$PORT' (must be a number from 1 to 65535)${NC}"
    done
    save_port "$PORT"
}

# ----------------------------------------------------------------------------
# get_android_ip — detect the device's IP address on the local network
#
# Tries several strategies in order of preference:
#   1. The wlan0 interface (most common Wi-Fi interface name)
#   2. The wlan1 interface (secondary Wi-Fi / hotspot)
#   3. Any 192.168.x.x address on any interface
#   4. Any 10.x.x.x address on any interface
#   5. The legacy `ifconfig` output as a last resort
#
# Returns (via stdout): the detected IP address.
# Exits the script with an error if nothing can be detected.
# ----------------------------------------------------------------------------
get_android_ip() {
    # Strategy 1: explicit wlan0 interface
    IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oP 'inet \K[0-9.]+' | head -1)
    # Strategy 2: explicit wlan1 interface
    if [ -z "$IP" ]; then
        IP=$(ip -4 addr show wlan1 2>/dev/null | grep -oP 'inet \K[0-9.]+' | head -1)
    fi
    # Strategy 3: any 192.168.x.x address on any interface
    if [ -z "$IP" ]; then
        IP=$(ip -4 addr 2>/dev/null | grep -oP 'inet \K192\.168\.[0-9]+\.[0-9]+' | head -1)
    fi
    # Strategy 4: any 10.x.x.x address on any interface
    if [ -z "$IP" ]; then
        IP=$(ip -4 addr 2>/dev/null | grep -oP 'inet \K10\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi
    # Strategy 5: legacy ifconfig output (older Android/Termux setups)
    if [ -z "$IP" ]; then
        IP=$(ifconfig 2>/dev/null | grep -oP 'inet addr:\K[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | grep -v '127.0.0.1' | head -1)
    fi
    # If every strategy failed, we cannot give the user a usable address
    if [ -z "$IP" ]; then
        echo -e "${RED}❌ Could not detect your Android IP!${NC}"
        echo -e "${YELLOW}Run: ${GREEN}ip -4 addr${NC}${YELLOW} and find your IP manually${NC}"
        exit 1
    fi
    echo "$IP"
}

