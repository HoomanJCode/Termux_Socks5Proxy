}

# ----------------------------------------------------------------------------
# stop_proxy — stop the running proxy using the PID file
#   Args: optional -q for quiet mode (used before starting a new instance)
# ----------------------------------------------------------------------------
stop_proxy() {
    local quiet=0
    [ "${1:-}" = "-q" ] && quiet=1

    if [ ! -f "$PID_FILE" ]; then
        [ "$quiet" -eq 1 ] || echo -e "${YELLOW}ℹ️  Proxy is not running (no PID file).${NC}"
        return 0
    fi

    local old_pid
    old_pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null \
        && grep -q "socks5_server.py" "/proc/$old_pid/cmdline" 2>/dev/null; then
        [ "$quiet" -eq 1 ] || echo -e "${YELLOW}⏹  Stopping proxy (PID $old_pid)...${NC}"
        kill "$old_pid" 2>/dev/null || true
        sleep 1   # give it a moment to release the port
        rm -f "$PID_FILE"
        [ "$quiet" -eq 1 ] || echo -e "${GREEN}✅ Proxy stopped.${NC}"
    elif [ -z "$old_pid" ] || ! kill -0 "$old_pid" 2>/dev/null; then
        # Process is gone or the PID file is garbage — safe to discard
        rm -f "$PID_FILE"
        [ "$quiet" -eq 1 ] || echo -e "${YELLOW}ℹ️  No running proxy found — removed stale PID file.${NC}"
    fi
    # Otherwise (process alive but identity unverifiable): keep the PID file
    # so we don't lose track of the running proxy.
}

# ----------------------------------------------------------------------------
# start_proxy — start the SOCKS5 proxy in the background
#   Args: optional port override (also saved)
# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# rotate_log — cap the log file so it can't grow without bound on a phone.
#   Called before each start; a log over 1 MiB is moved aside (one backup).
# ----------------------------------------------------------------------------
rotate_log() {
    local logfile="$CONFIG_DIR/proxy.log" max=1048576
    [ -f "$logfile" ] || return 0
    if [ "$(wc -c < "$logfile" 2>/dev/null || echo 0)" -gt "$max" ]; then
        mv -f "$logfile" "$logfile.1" 2>/dev/null || true
    fi
}

start_proxy() {
    # 1) Choose the port (saved port is used automatically; the first argument
    #    can override it, e.g. `socks5-proxy 9999`)
    get_port "$1"

    # 2) Choose the bind IP (saved IP, or all interfaces by default)
    BIND_IP=$(get_stored_ip)
    if [ -z "$BIND_IP" ]; then
        BIND_IP="0.0.0.0"
    elif ! is_valid_ip "$BIND_IP"; then
        echo -e "${YELLOW}⚠️  Saved IP '$BIND_IP' is invalid — listening on all interfaces.${NC}"
        BIND_IP="0.0.0.0"
    fi

    echo -e ""
    echo -e "${YELLOW}⏳ Starting SOCKS5 proxy on $BIND_IP:$PORT...${NC}"

    # 3) Stop any leftover proxy from a previous session
    stop_proxy -q

    # 3b) Rotate the log if it has grown past 1 MiB
    rotate_log

# 4) Make sure Python is installed; install it via Termux's package manager
#    if it is missing.
if ! command -v python &> /dev/null; then
    echo -e "${YELLOW}📦 Installing Python...${NC}"
    pkg install python -y
fi

# 5) Generate the Python SOCKS5 server.
#    NOTE: the heredoc delimiter is quoted ('EOL'), so no variable expansion
#    happens — the script is written to disk exactly as shown below.
cat > "$CONFIG_DIR/socks5_server.py" << 'EOL'
#!/data/data/com.termux/files/usr/bin/python

# -----------------------------------------------------------------------------
# Minimal SOCKS5 (RFC 1928) proxy server with optional username/password
# authentication (RFC 1929).
#
# Protocol flow handled here:
#   1. Client greets us:  VER(0x05) NMETHODS ...METHODS          (handshake)
#   2. We pick an auth method: 0x00 (none) or 0x02 (user/password).
#      Auth is enabled only when the SOCKS5_USER environment variable is set.
#   3. If auth is required: the RFC 1929 VER ULEN UNAME PLEN PASSWD exchange
#   4. Client sends a request: VER CMD RSV ATYP ...ADDR... PORT
#   5. We connect to the requested target and relay traffic both ways
# -----------------------------------------------------------------------------

import os
import socket
import threading
import sys
import struct
import errno
import hmac
import time
import queue
import collections

# Listening port: taken from the command line, defaulting to 1080
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 1080
# Bind address: taken from the command line, defaulting to all interfaces
BIND_IP = sys.argv[2] if len(sys.argv) > 2 else '0.0.0.0'
# Relay chunk size: 64 KiB reduces syscall overhead and improves throughput
BUFFER_SIZE = 65536
# Requested kernel socket buffer size (Linux doubles the requested value)
SOCK_BUF_SIZE = 262144
# A relay (TCP or UDP) that moves no data for this many seconds is torn down,
# freeing its thread and sockets. Configurable via the SOCKS5_IDLE_TIMEOUT
# environment variable (the launcher reads it from the config file).
# The tolerance fallback keeps the server alive even if the env value was
# hand-edited to something non-numeric.
def _env_int(name, default):
    try:
        return max(1, int(os.environ.get(name, default)))
    except ValueError:
        return int(default)

IDLE_TIMEOUT = _env_int('SOCKS5_IDLE_TIMEOUT', '600')
# Maximum simultaneous client connections. Extra clients are closed without a
# handshake, protecting threads and memory from connection floods.
# Configurable via SOCKS5_MAX_CONNS.
MAX_CONNS = _env_int('SOCKS5_MAX_CONNS', '256')
# Log verbosity: debug < info < warning < error (default: warning). The
# launcher passes it from the LOG_LEVEL config key as SOCKS5_LOG_LEVEL.
# An unknown value falls back to warning so a hand-edited config can't
# crash the server or silence its errors.
LOG_LEVEL = os.environ.get('SOCKS5_LOG_LEVEL', 'warning').strip().lower()
_LOG_RANKS = {'debug': 10, 'info': 20, 'warning': 30, 'error': 40}
LOG_LEVEL_RANK = _LOG_RANKS.get(LOG_LEVEL, 30)


def log(level, msg, stream=sys.stdout):
    """Emit `msg` when `level` is at or above the configured log level."""
    if _LOG_RANKS.get(level, 30) >= LOG_LEVEL_RANK:
        print(msg, file=stream, flush=True)

# Optional RFC 1929 username/password authentication. Disabled by default:
# it only kicks in when SOCKS5_USER is set (the launcher provides it).
AUTH_USER = os.environ.get('SOCKS5_USER', '')
AUTH_PASS = os.environ.get('SOCKS5_PASS', '')
AUTH_REQUIRED = bool(AUTH_USER)

# Shared UDP socket used for UDP ASSOCIATE relay (created in main())
udp_sock = None

# Serializes authentication attempts so a failed login throttles the next
# one too (a fresh connection would otherwise be handled by a new thread
# and brute force would go unhindered)
auth_lock = threading.Lock()

# Live stats for the launcher's `status` command. The launcher passes a
# stats-file path via the SOCKS5_STATS environment variable; a background
# thread refreshes the file every couple of seconds. SOCKS5_CONNS points at
# a second file holding the most recent completed connections.
STATS_FILE = os.environ.get('SOCKS5_STATS', '')
CONNS_FILE = os.environ.get('SOCKS5_CONNS', '')
START_TIME = time.time()
_stats_lock = threading.Lock()
_active_conns = 0
_total_conns = 0
_bytes_up = 0      # cumulative bytes relayed client -> target
_bytes_down = 0    # cumulative bytes relayed target -> client
# Most recent completed connections (newest first) for the launcher's
# `status` command: (start, peer, dest, up, down, duration)
_recent_conns = collections.deque(maxlen=20)


def stats_writer():
    """Periodically persist live stats for the launcher's `status` command."""
    if not STATS_FILE:
        return
    while True:
        with _stats_lock:
            try:
                with open(STATS_FILE, 'w') as f:
                    f.write('START=%d\nACTIVE=%d\nTOTAL=%d\nUP=%d\nDOWN=%d\n' % (
                        int(START_TIME), _active_conns, _total_conns,
                        _bytes_up, _bytes_down))
                if CONNS_FILE:
                    with open(CONNS_FILE, 'w') as f:
                        for rec in _recent_conns:
                            f.write('%d|%s|%s|%d|%d|%d\n' % rec)
            except OSError:
                pass
        time.sleep(2)


def tune_socket(sock):
    """Apply performance tweaks to a connected socket."""
    try:
        # Disable Nagle's algorithm — lower latency for interactive traffic
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        # Larger kernel buffers — fewer stalls under load
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, SOCK_BUF_SIZE)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, SOCK_BUF_SIZE)
        # Detect dead peers instead of hanging forever
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    except OSError:
        pass   # unsupported option — keep the kernel default


def recv_exact(sock, n):
    """Read exactly n bytes from `sock`, looping until complete (or EOF).

    TCP has no message boundaries, so a single recv() may return fewer
    bytes than expected. Returns the bytes actually read (shorter than n
    if the peer closed the connection early).
    """
    data = b''
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            break   # connection closed before n bytes arrived
        data += chunk
    return data


# ---------------------------------------------------------------------------
# UDP ASSOCIATE relay (RFC 1928).
#
# A single dispatcher thread owns the shared UDP socket and reads every
# datagram, then routes it to the right client's per-client queue. Each
# client has its own relay thread that forwards its queued datagrams to the
# target and sends the target's replies back to the client. Because only the
# dispatcher calls recvfrom on the shared socket, concurrent clients can
# never steal each other's packets.
# ---------------------------------------------------------------------------
udp_lock = threading.Lock()
udp_bound = {}      # (client ip, client udp port) -> UdpAssociation
udp_pending = {}    # client ip -> [UdpAssociation] (before the 1st datagram)


class UdpAssociation:
    """One UDP ASSOCIATE: the TCP association, its outbound queue, and the
    socket used to reach the relayed target."""

    def __init__(self, tcp_sock):
        peer = tcp_sock.getpeername()
        self.tcp_sock = tcp_sock
        self.client_ip = peer[0]
        self.tcp_peer_port = peer[1]
        self.client_udp = None      # (ip, port) learned from the 1st datagram
        self.queue = queue.Queue()  # datagrams routed here by the dispatcher
        self.target = None          # socket toward the relayed target
        self.dest = None            # (addr, port) that self.target talks to
        self.reply_hdr = None       # ATYP + address bytes for reply headers
        self.dest_port = 0
        self.bytes_up = 0           # payload bytes sent toward the target
        self.bytes_down = 0         # reply bytes sent back to the client
        self.started = time.time()
        self.alive = True


def _find_assoc(src):
    """Map a datagram's source to its association (None if no match).

    Once a client's first datagram reveals its UDP (ip, port), that exact
    pair is bound to the association. Before that, the datagram is matched
    to a pending association by IP — preferring the one whose TCP peer port
    equals the UDP source port (what real SOCKS clients do), then the most
    recent association as a fallback for same-IP clients.

    Requirement for clients behind the same IP: bind each client's UDP
    socket to a distinct source port (ideally the one matching its TCP
    port). The first datagram binds the (ip, port) pair, so two same-IP
    clients using the same UDP source port can only be told apart once
    their datagrams have been seen.
    """
    with udp_lock:
        assoc = udp_bound.get(src)
        if assoc is not None:
            return assoc if assoc.alive else None
        plist = udp_pending.get(src[0])
        if not plist:
            return None
        match = None
        for a in plist:
            if a.alive and a.tcp_peer_port == src[1]:
                match = a
                break
        if match is None:
            for a in reversed(plist):   # most recent association wins
                if a.alive:
                    match = a
                    break
        if match is None:
            return None
        # Bind this (ip, port) to the association so later datagrams match
        # exactly, and move it out of the pending list.
        plist.remove(match)
        if not plist:
            del udp_pending[src[0]]
        match.client_udp = src
        udp_bound[src] = match
        return match


def udp_dispatcher():
    """Single owner of the shared UDP socket: read every datagram and route
    it to the right client's queue. Runs until the server socket closes."""
    while True:
        try:
            data, src = udp_sock.recvfrom(65535)
        except OSError:
            return   # server socket closed — shutting down
        assoc = _find_assoc(src)
        if assoc is not None:
            assoc.queue.put_nowait((data, src))   # unbounded — never drops


def _relay_datagram(assoc, data, src):
    """Parse one SOCKS5 UDP datagram and forward its payload to the target."""
    if src != assoc.client_udp:
        return   # datagram from an unexpected socket — drop it
    if len(data) < 4 or data[2] != 0:
        return   # FRAG != 0 (fragmentation) is unsupported
    atyp = data[3]
    try:
        if atyp == 0x01:   # IPv4
            addr = socket.inet_ntoa(data[4:8])
            reply_hdr = data[3:8]           # ATYP + IPv4 address
            family = socket.AF_INET
            off = 8
        elif atyp == 0x03:   # domain name
            dlen = data[4]
            addr = data[5:5 + dlen].decode('utf-8')
            reply_hdr = data[3:5 + dlen]    # ATYP + len + name
            family = socket.AF_INET
            off = 5 + dlen
        elif atyp == 0x04:   # IPv6
            addr = socket.inet_ntop(socket.AF_INET6, data[4:20])
            reply_hdr = data[3:20]          # ATYP + IPv6 address
            family = socket.AF_INET6
            off = 20
        else:
            return   # unknown address type
        port = struct.unpack('>H', data[off:off + 2])[0]
        payload = data[off + 2:]
        # (Re)open the target socket when the destination changes.
        # Non-blocking: replies are drained opportunistically below, so a
        # slow target can never stall the relay (or its whole client queue).
        if assoc.dest != (addr, port):
            if assoc.target:
                assoc.target.close()
            assoc.target = socket.socket(family, socket.SOCK_DGRAM)
            assoc.target.setblocking(False)
            assoc.dest = (addr, port)
            assoc.reply_hdr = reply_hdr
            assoc.dest_port = port
        assoc.target.sendto(payload, assoc.dest)
        assoc.bytes_up += len(payload)
    except (OSError, ValueError, IndexError):
        pass   # malformed datagram — drop it


def _drain_replies(assoc, block=0):
    """Send replies waiting on the target socket back to the client, with
    headers. Non-blocking by default; when `block` is non-zero, wait up to
    that many seconds for the first reply (used when the client is idle, so
    its replies arrive promptly instead of on the next poll).
    Returns True if at least one reply was delivered (i.e. traffic flowed)."""
    target = assoc.target
    if target is None or assoc.client_udp is None:
        return False
    if block:
        target.settimeout(block)
    got = False
    while True:
        try:
            resp, _ = target.recvfrom(65535)
        except BlockingIOError:
            return got   # nothing waiting — done for now
        except socket.timeout:
            return got
        except OSError:
            return got
        hdr = b'\x00\x00\x00' + assoc.reply_hdr + struct.pack('>H', assoc.dest_port)
        try:
            udp_sock.sendto(hdr + resp, assoc.client_udp)
            assoc.bytes_down += len(resp)
            got = True
        except OSError:
            return got


def udp_client_loop(assoc):
    """Relay one client's UDP datagrams until its TCP association closes."""
    global _bytes_up, _bytes_down, _recent_conns
    tcp = assoc.tcp_sock
    tcp.setblocking(False)
    last_active = time.time()   # bumped whenever traffic flows
    try:
        while True:
            # Idle associations are closed too, so a client that opened a
            # UDP ASSOCIATE and then went silent can't hold a thread forever
            if time.time() - last_active > IDLE_TIMEOUT:
                break
            # Closing the TCP association tears the relay down
            try:
                if tcp.recv(1, socket.MSG_PEEK) == b'':
                    break
            except (BlockingIOError, OSError):
                pass
            # Relay queued outbound datagrams, then drain any replies.
            # (assoc.client_udp and assoc.alive are written by the dispatcher
            # under udp_lock, but the queue handoff makes them visible here.)
            try:
                data, src = assoc.queue.get(timeout=0.05)
            except queue.Empty:
                data = None
            if data is not None:
                _relay_datagram(assoc, data, src)
                last_active = time.time()
                if _drain_replies(assoc):
                    last_active = time.time()
            else:
                # Idle: wait briefly for a reply so it arrives at RTT speed
                # instead of on the next poll, without stalling the loop
                # while datagrams are still queued.
                if _drain_replies(assoc, block=0.1):
                    last_active = time.time()
    except OSError:
        pass
    finally:
        assoc.alive = False
        if assoc.target:
            assoc.target.close()
        with udp_lock:
            if assoc.client_udp:
                udp_bound.pop(assoc.client_udp, None)
            plist = udp_pending.get(assoc.client_ip)
            if plist and assoc in plist:
                plist.remove(assoc)
                if not plist:
                    del udp_pending[assoc.client_ip]
        # Fold this association's byte counts into the totals and record it
        # for `status` (only when it actually moved data).
        if assoc.bytes_up or assoc.bytes_down:
            with _stats_lock:
                _bytes_up += assoc.bytes_up
                _bytes_down += assoc.bytes_down
                if assoc.dest:
                    _recent_conns.appendleft((
                        int(assoc.started),
                        '%s:%d' % (assoc.client_ip, assoc.tcp_peer_port),
                        '%s:%d' % assoc.dest,
                        assoc.bytes_up, assoc.bytes_down,
                        int(time.time() - assoc.started)))


def handle_client(client_socket):
    """Handle a single SOCKS5 client connection on its own thread."""
    global _active_conns, _bytes_up, _bytes_down, _recent_conns
    started = time.time()
    try:
        # --- SOCKS5 handshake (client greeting) -----------------------------
        # First message: VER(1) NMETHODS(1) METHODS(NMETHODS) — max 257 bytes
        data = recv_exact(client_socket, 2)      # VER + NMETHODS
        if len(data) < 2 or data[0] != 0x05:
            client_socket.close()
            return
        nmethods = data[1]
        # Read the list of authentication methods the client offers
        methods = recv_exact(client_socket, nmethods)
        if len(methods) < nmethods:
            client_socket.close()
            return

        if AUTH_REQUIRED:
            # Only username/password (0x02) is acceptable when auth is on
            if 0x02 not in methods:
                client_socket.sendall(b'\x05\xff')   # no acceptable methods
                client_socket.close()
                return
            client_socket.sendall(b'\x05\x02')       # we require user/password

            # --- RFC 1929 username/password subnegotiation -------------------
            # The lock serializes attempts: on a failure we sleep while still
            # holding it, so the next client's login is forced to wait.
            # The socket timeout bounds the whole exchange, so a client that
            # stalls without sending credentials can't hold the global lock
            # forever (which would lock out every other login).
            client_socket.settimeout(10)
            auth_lock.acquire()
            try:
                auth = recv_exact(client_socket, 2)      # VER + ULEN
                if len(auth) < 2 or auth[0] != 0x01:
                    client_socket.close()
                    return
                ulen = auth[1]
                uname = recv_exact(client_socket, ulen)
                if len(uname) < ulen:
                    client_socket.close()
                    return
                plen = recv_exact(client_socket, 1)
                if len(plen) < 1:
                    client_socket.close()
                    return
                passwd = recv_exact(client_socket, plen[0])
                if len(passwd) < plen[0]:
                    client_socket.close()
                    return
                # Constant-time comparison prevents timing side-channels
                if hmac.compare_digest(uname, AUTH_USER.encode('utf-8')) \
                        and hmac.compare_digest(passwd, AUTH_PASS.encode('utf-8')):
                    client_socket.settimeout(None)   # back to blocking relay
                    client_socket.sendall(b'\x01\x00')   # success
                else:
                    client_socket.sendall(b'\x01\x01')   # failure
                    # Hold the lock during the sleep so the NEXT client's
                    # auth attempt is delayed too (global throttle)
                    time.sleep(2)
                    client_socket.close()
                    return
            finally:
                auth_lock.release()
        else:
            # No authentication (the default)
            client_socket.sendall(b'\x05\x00')

        # --- SOCKS5 request ------------------------------------------------
        # Second message: VER(1) CMD(1) RSV(1) ATYP(1) ADDR(4..255) PORT(2)
        header = recv_exact(client_socket, 4)    # VER + CMD + RSV + ATYP
        if len(header) < 4:
            client_socket.close()
            return

        ver = header[0]    # SOCKS version (should be 0x05)
        cmd = header[1]    # command: CONNECT / BIND / UDP ASSOCIATE
        atyp = header[3]   # address type: IPv4 / domain name / IPv6

        # CONNECT (0x01) and UDP ASSOCIATE (0x03) are supported; BIND (0x02)
        # is rejected with REP 0x07 (command not supported)
        if ver != 0x05 or cmd not in (0x01, 0x03):
            client_socket.sendall(b'\x05\x07\x00\x01\x00\x00\x00\x00\x00\x00')
            client_socket.close()
            return

        # Read the destination address + port according to ATYP
        if atyp == 0x01:    # IPv4 (4 bytes)
            addr = socket.inet_ntoa(recv_exact(client_socket, 4))
            port = struct.unpack('>H', recv_exact(client_socket, 2))[0]
            family = socket.AF_INET
        elif atyp == 0x03:  # Domain name (1 length byte + name)
            domain_len = recv_exact(client_socket, 1)[0]
            addr = recv_exact(client_socket, domain_len).decode('utf-8')
            port = struct.unpack('>H', recv_exact(client_socket, 2))[0]
            family = socket.AF_INET   # the hostname is resolved by connect()
        elif atyp == 0x04:  # IPv6 (16 bytes)
            addr = socket.inet_ntop(socket.AF_INET6, recv_exact(client_socket, 16))
            port = struct.unpack('>H', recv_exact(client_socket, 2))[0]
            family = socket.AF_INET6
        else:
            # Unknown address type -> drop the connection
            client_socket.close()
            return

        if cmd == 0x03:
            # --- UDP ASSOCIATE ------------------------------------------------
            # Tell the client where to send UDP datagrams: the same port, on
            # the address the client actually reached us through (so it works
            # even when listening on 0.0.0.0). Then relay until the client
            # closes the TCP association.
            try:
                bnd_ip = client_socket.getsockname()[0]
            except OSError:
                bnd_ip = BIND_IP
            if ':' in bnd_ip:
                response = b'\x05\x00\x00\x04' + socket.inet_pton(socket.AF_INET6, bnd_ip)
            else:
                response = b'\x05\x00\x00\x01' + socket.inet_aton(bnd_ip)
            response += struct.pack('>H', PORT)
            client_socket.sendall(response)

            # Register the association and start its relay thread. Joining
            # keeps this TCP connection alive until the client closes it;
            # the relay thread then cleans up and exits on its own.
            assoc = UdpAssociation(client_socket)
            with udp_lock:
                udp_pending.setdefault(assoc.client_ip, []).append(assoc)
            relay_thread = threading.Thread(
                target=udp_client_loop, args=(assoc,), daemon=True)
            relay_thread.start()
            relay_thread.join()
            return

        # --- Connect to the requested target --------------------------------
        try:
            target_socket = socket.socket(family, socket.SOCK_STREAM)
            target_socket.settimeout(30)          # timeout only the connect
            target_socket.connect((addr, port))   # establish the connection
            target_socket.settimeout(None)        # blocking once connected
            tune_socket(target_socket)            # latency + buffer tuning
        except Exception as e:
            # Map the failure to the closest SOCKS5 reply code so real
            # clients can tell a refused host from an unreachable one
            if isinstance(e, (socket.timeout, socket.gaierror)) or \
                    (isinstance(e, OSError) and e.errno in (
                        errno.ENETUNREACH, errno.EHOSTUNREACH,
                        errno.ENETDOWN, errno.EADDRNOTAVAIL)):
                rep = 0x04   # host unreachable (incl. DNS failures)
            elif isinstance(e, ConnectionRefusedError):
                rep = 0x05   # connection refused
            else:
                rep = 0x01   # general failure
            # Log the failure (the launcher sends stderr to the log file)
            log('warning', 'CONNECT %s:%d failed: %s' % (addr, port, e), stream=sys.stderr)
            client_socket.sendall(
                b'\x05' + bytes([rep]) + b'\x00\x01' +
                b'\x00\x00\x00\x00\x00\x00')
            client_socket.close()
            return

        # --- Success reply (REP 0x00 = succeeded) ---------------------------
        # BND.ADDR/BND.PORT are unused for CONNECT, so zeros are acceptable
        bind_addr = '0.0.0.0'
        bind_port = 0
        response = b'\x05\x00\x00\x01'
        response += socket.inet_aton(bind_addr)
        response += struct.pack('>H', bind_port)
        client_socket.sendall(response)

        # --- Bidirectional traffic relay ------------------------------------
        # Copy client -> target on a background thread, and target -> client
        # on this thread (the main loop keeps the connection alive). Both
        # directions count bytes into the same per-connection counters.
        # `done` lets either direction wind the other down when it finishes,
        # and the short recv timeouts make that prompt even when the peer on
        # the other side never sends anything else.
        try:
            peer = '%s:%d' % client_socket.getpeername()[:2]
        except OSError:
            peer = '?'
        counters = {'up': 0, 'down': 0}
        done = threading.Event()
        # `last` is bumped whenever either direction moves data; `left`
        # counts the directions still running. The sockets are only closed
        # once BOTH have stopped, so a half-closed peer (a client that
        # finished sending but is still reading, e.g. a download) keeps
        # receiving in-flight replies.
        state = {'last': time.time(), 'left': 2, 'reason': {}}
        client_socket.settimeout(1)
        target_socket.settimeout(1)

        def forward(src, dst, direction):
            """Copy data from `src` to `dst`, counting bytes in `direction`."""
            reason = 'eof'   # src closed -> we half-close dst and stop
            try:
                while True:
                    try:
                        data = src.recv(BUFFER_SIZE)
                    except socket.timeout:
                        if done.is_set():
                            reason = 'teardown'   # the other direction ended
                            break
                        if time.time() - state['last'] > IDLE_TIMEOUT:
                            done.set()   # idle too long — wind everything down
                            reason = 'idle'
                            break
                        continue
                    if not data:
                        # Source closed: half-close the destination so it sees
                        # FIN and can finish sending in-flight data. The other
                        # direction keeps running until IT also ends (or the
                        # idle timeout fires), so no bytes are dropped.
                        try:
                            dst.shutdown(socket.SHUT_WR)
                        except OSError:
                            pass
                        break
                    dst.sendall(data)   # sendall: never silently truncates
                    with _stats_lock:
                        state['last'] = time.time()
                        counters[direction] += len(data)
            except OSError:
                reason = 'reset'   # connection reset / closed — stop copying
            finally:
                # Close both sockets only when this was the last direction
                with _stats_lock:
                    state['reason'][direction] = reason
                    state['left'] -= 1
                    if state['left'] == 0:
                        done.set()
                        src.close()
                        dst.close()

        up_thread = threading.Thread(
            target=forward, args=(client_socket, target_socket, 'up'),
            daemon=True)
        log('debug', 'tunnel %s -> %s:%d established' % (peer, addr, port))
        up_thread.start()
        forward(target_socket, client_socket, 'down')
        up_thread.join(timeout=5)   # let the last client->target bytes count

        # At debug level, report why each direction ended so the user can see
        # whether the proxy closed it (idle) or a peer did (eof/reset)
        log('debug', 'tunnel %s -> %s:%d closed: up=%s down=%s '
            'up_bytes=%d down_bytes=%d secs=%.0fs'
            % (peer, addr, port, state['reason'].get('up', '?'),
               state['reason'].get('down', '?'), counters['up'],
               counters['down'], time.time() - started))

        # Record this connection for the launcher's `status` command. Like the
        # UDP side, only connections that actually moved data are listed.
        if counters['up'] or counters['down']:
            with _stats_lock:
                _bytes_up += counters['up']
                _bytes_down += counters['down']
                _recent_conns.appendleft((
                    int(started), peer, '%s:%d' % (addr, port),
                    counters['up'], counters['down'],
                    int(time.time() - started)))

    except Exception as e:
        # Log unexpected failures so the launcher's `logs` command shows them
        log('error', 'Error handling client: %s' % e, stream=sys.stderr)
    finally:
        # Decrement the live-connection counter (protected by the stats lock)
        with _stats_lock:
            _active_conns -= 1
        client_socket.close()


def main():
    """Create the listening socket and serve clients forever."""
    global udp_sock, _active_conns, _total_conns
    # An IPv6 bind address (e.g. "::" for all interfaces) uses AF_INET6,
    # with dual-stack enabled when the kernel allows it
    if ':' in BIND_IP:
        server = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
        try:
            server.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        except OSError:
            pass   # dual-stack unsupported — IPv6 only
    else:
        server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    # Allow immediate rebinding after the proxy is killed/restarted
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    # Listen on the configured address (0.0.0.0 = all interfaces)
    server.bind((BIND_IP, PORT))
    server.listen(50)

    # UDP socket for the UDP ASSOCIATE relay (same port number as TCP)
    udp_sock = socket.socket(server.family, socket.SOCK_DGRAM)
    udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    udp_sock.bind((BIND_IP, PORT))

    # The startup banner is always shown (even at the default warning level)
    # so `socks5-proxy logs` always confirms the proxy is serving
    print(f"SOCKS5 proxy running on {BIND_IP}:{PORT}", flush=True)
    print("Ready for connections...", flush=True)

    # Keep the launcher's `status` command up to date with live stats
    threading.Thread(target=stats_writer, daemon=True).start()

    # Route UDP ASSOCIATE datagrams to their per-client relay threads
    threading.Thread(target=udp_dispatcher, daemon=True).start()

    # Accept loop: hand each incoming client to its own daemon thread
    while True:
        client, addr = server.accept()
        tune_socket(client)   # apply latency + buffer tuning to the peer
        # Enforce the connection cap before spawning a thread, so a flood of
        # new connections can't exhaust threads or memory
        with _stats_lock:
            if _active_conns >= MAX_CONNS:
                over = True
            else:
                over = False
                _active_conns += 1
                _total_conns += 1
        if over:
            try:
                client.close()
            except OSError:
                pass
            log('warning', 'Rejected connection from %s:%d (limit %d reached)'
                % (addr[0], addr[1], MAX_CONNS), stream=sys.stderr)
            continue
        log('info', f"Connection from {addr[0]}:{addr[1]}")
        threading.Thread(target=handle_client, args=(client,), daemon=True).start()


if __name__ == "__main__":
    main()
