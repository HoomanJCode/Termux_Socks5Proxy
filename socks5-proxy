echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✅ SOCKS5 PROXY IS RUNNING!${NC}"
echo -e "${GREEN}========================================${NC}"
echo -e ""
echo -e "${YELLOW}📱 On your PC, configure:${NC}"
echo -e "   Type: ${GREEN}SOCKS5${NC}"
echo -e "   Host: ${GREEN}${ANDROID_IP}${NC}"
echo -e "   Port: ${GREEN}${PORT}${NC}"
echo -e "   Listening on: ${GREEN}${BIND_IP}:${PORT}${NC}"
echo -e ""
echo -e "${YELLOW}🧪 Test with curl:${NC}"
if [ -n "$AUTH_USER" ]; then
    echo -e "   ${GREEN}curl --socks5 ${AUTH_USER}:${AUTH_PASS}@${ANDROID_IP}:${PORT} https://api.ipify.org${NC}"
else
    echo -e "   ${GREEN}curl --socks5 ${ANDROID_IP}:${PORT} https://api.ipify.org${NC}"
fi
echo -e ""
echo -e "${YELLOW}📁 Config saved to: $CONFIG_FILE${NC}"
echo -e "${YELLOW}📁 Python script at: $CONFIG_DIR/socks5_server.py${NC}"
echo -e "${YELLOW}🔢 Port: $PORT${NC}"
echo -e ""
if [ -n "$AUTH_USER" ]; then
    echo -e "${GREEN}🔒 Authentication enabled (user: $AUTH_USER)${NC}"
else
    echo -e "${RED}⚠️  Security: No authentication! Use only on trusted networks.${NC}"
fi
echo -e "${GREEN}========================================${NC}"
echo -e ""
echo -e "${YELLOW}Commands:${NC}"
echo -e "   Stop:        ${GREEN}socks5-proxy stop${NC}"
echo -e "   Status:      ${GREEN}socks5-proxy status${NC}"
echo -e "   Logs:        ${GREEN}socks5-proxy logs${NC}"
echo -e "   Change port: ${GREEN}socks5-proxy set port <PORT>${NC}"
echo -e "   Change IP:   ${GREEN}socks5-proxy set ip <IP>${NC}"
echo -e "   Uninstall:   ${GREEN}rm -rf $CONFIG_DIR && rm $PREFIX/bin/socks5-proxy${NC}"
echo -e ""

# 10) The proxy is already detached (new session, nohup), so `start` returns
#     to the prompt immediately — Ctrl+C on the terminal never touches it.
}

# ----------------------------------------------------------------------------
# is_running — check whether our proxy is currently running
#   Returns: 0 if running, 1 otherwise
# ----------------------------------------------------------------------------
is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    grep -q "socks5_server.py" "/proc/$pid/cmdline" 2>/dev/null
}

# ----------------------------------------------------------------------------
# format_uptime — turn a start timestamp into a human-readable duration
#   Args: $1 = Unix epoch seconds when the proxy started
# ----------------------------------------------------------------------------
format_uptime() {
    local secs=$(( $(date +%s) - ${1:-0} ))
    [ "$secs" -lt 0 ] && secs=0
    local d=$((secs / 86400)) h=$(((secs % 86400) / 3600))
    local m=$(((secs % 3600) / 60)) s=$((secs % 60))
    local out=""
    [ "$d" -gt 0 ] && out+="${d}d "
    [ "$h" -gt 0 ] && out+="${h}h "
    [ "$m" -gt 0 ] && out+="${m}m "
    out+="${s}s"
    echo "$out"
}

# ----------------------------------------------------------------------------
# format_bytes — print a byte count in human-readable form
#   Args: $1 = number of bytes
#   Returns (via stdout): e.g. "1.2 KiB" / "3.4 MiB" / "900 B"
#   Pure bash integer math (n*10/div) so it needs no awk or python.
# ----------------------------------------------------------------------------
format_bytes() {
    local n=${1:-0} unit="B"
    if [ "$n" -ge 1073741824 ]; then
        unit="GiB"; n=$(( (n * 10) / 1073741824 ))
    elif [ "$n" -ge 1048576 ]; then
        unit="MiB"; n=$(( (n * 10) / 1048576 ))
    elif [ "$n" -ge 1024 ]; then
        unit="KiB"; n=$(( (n * 10) / 1024 ))
    else
        echo "${n} B"
        return
    fi
    echo "$((n / 10)).$((n % 10)) ${unit}"
}

# ----------------------------------------------------------------------------
# show_status — print whether the proxy is running and the saved settings
# ----------------------------------------------------------------------------
show_status() {
    local running="no" pid=""
    if is_running; then
        running="yes"
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
    fi

    local port=$(get_stored_port)
    local ip=$(get_stored_ip)
    local user=$(get_stored_user)

    echo -e "${GREEN}===== SOCKS5 Proxy Status =====${NC}"
    echo -e "   Running: ${GREEN}$running${NC}"
    [ "$running" = "yes" ] && echo -e "   PID:     ${GREEN}$pid${NC}"
    echo -e "   Port:    ${GREEN}${port:-1080 (default)}${NC}"
    echo -e "   Listen:  ${GREEN}${ip:-0.0.0.0 (all interfaces)}${NC}"
    if [ "$running" = "yes" ] && [ -f "$CONFIG_DIR/stats" ]; then
        # Live stats written by the proxy every few seconds
        local start_t active total up down
        start_t=$(sed -n 's/^START=//p' "$CONFIG_DIR/stats" | head -1)
        active=$(sed -n 's/^ACTIVE=//p' "$CONFIG_DIR/stats" | head -1)
        total=$(sed -n 's/^TOTAL=//p' "$CONFIG_DIR/stats" | head -1)
        up=$(sed -n 's/^UP=//p' "$CONFIG_DIR/stats" | head -1)
        down=$(sed -n 's/^DOWN=//p' "$CONFIG_DIR/stats" | head -1)
        [ -n "$start_t" ] && echo -e "   Uptime:  ${GREEN}$(format_uptime "$start_t")${NC}"
        [ -n "$active" ] && echo -e "   Active:  ${GREEN}${active}${NC} connection(s), ${total:-0} total"
        [ -n "$up" ] && echo -e "   Traffic: ${GREEN}$(format_bytes "$up")${NC} up / ${GREEN}$(format_bytes "$down")${NC} down"
        # Most recent connections (newest first), with bytes relayed each way
        if [ -s "$CONFIG_DIR/conns" ]; then
            echo -e "   ${YELLOW}Recent connections (last ${YELLOW}$(wc -l < "$CONFIG_DIR/conns")${YELLOW}):${NC}"
            local i=0
            while IFS='|' read -r st peer dest upc downc secs; do
                [ "$i" -ge 5 ] && break
                i=$((i + 1))
                echo -e "     ${BLUE}$peer${NC} -> ${BLUE}$dest${NC}  "\
                    "$(format_bytes "$upc") up / $(format_bytes "$downc") down  "\
                    "(${YELLOW}${secs}s${NC})"
            done < "$CONFIG_DIR/conns"
        fi
    fi
    if [ -n "$user" ]; then
        echo -e "   Auth:    ${GREEN}on (user: $user)${NC}"
    else
        echo -e "   Auth:    ${YELLOW}off${NC}"
    fi
}

# ----------------------------------------------------------------------------
# show_status_watch — live-refreshing status, re-drawn every $1 seconds
#   (default 2, matching the server's stats-file cadence).
#   When stdout is not a terminal (pipes, scripts) it prints one snapshot and
#   returns, so nothing ever hangs non-interactively.
# ----------------------------------------------------------------------------
show_status_watch() {
    local interval="${1:-2}"
    if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 1 ] || [ "$interval" -gt 60 ]; then
        echo -e "${RED}❌ Invalid interval: '$interval' (must be a number from 1 to 60 seconds)${NC}"
        exit 1
    fi
    if [ ! -t 1 ]; then
        # Not a terminal — a single snapshot is enough (scripts must not hang)
        show_status
        return 0
    fi
    # Restore the cursor and exit cleanly on Ctrl+C
    trap 'printf "\033[?25h"; exit 0' INT TERM
    printf '\033[?25l'   # hide the cursor while refreshing
    while true; do
        printf '\033[2J\033[H'   # clear screen + move cursor home
        echo -e "${BLUE}● live status — refresh every ${interval}s — Ctrl+C to exit${NC}"
        echo -e "${YELLOW}  $(date '+%Y-%m-%d %H:%M:%S')${NC}"
        show_status
        sleep "$interval"
    done
}

# ----------------------------------------------------------------------------
# colorize_log — color proxy log lines by their level (reads stdin)
#   banner -> green, connections -> cyan, warnings -> yellow, errors -> red;
#   anything else is passed through untouched so piping stays clean
# ----------------------------------------------------------------------------
colorize_log() {
    local line level
    while IFS= read -r line; do
        case "$line" in
            *"Error handling client"*)   level="$RED" ;;
            *"CONNECT "*)                level="$YELLOW" ;;
            *"Rejected connection"*)     level="$YELLOW" ;;
            *"Connection from"*)         level="$CYAN" ;;
            *"SOCKS5 proxy running"*|*"Ready for connections"*) level="$GREEN" ;;
            *)                           level="" ;;
        esac
        if [ -n "$level" ]; then
            echo -e "${level}${line}${NC}"
        else
            echo "$line"
        fi
    done
}

# ----------------------------------------------------------------------------
# show_logs — show the proxy's log output
#   Follows live (tail -f) when running; shows the last lines otherwise.
#   Colors are applied automatically when stdout is a terminal; use --color
#   (or -c) to force color even when piped, and --plain (or -p) to disable it.
# ----------------------------------------------------------------------------
show_logs() {
    local logfile="$CONFIG_DIR/proxy.log" color=auto
    case "${1:-}" in
        -c|--color) color=on ;;
        -p|--plain) color=off ;;
        "") ;;
        *)
            echo -e "${RED}❌ Usage: socks5-proxy logs [-c|--color] [-p|--plain]${NC}"
            return 1
            ;;
    esac
    local use_color=0
    if [ "$color" = on ] || { [ "$color" = auto ] && [ -t 1 ]; }; then
        use_color=1
    fi
    if [ ! -f "$logfile" ]; then
        echo -e "${YELLOW}ℹ️  No log file yet — start the proxy first.${NC}"
        return 0
    fi
    if is_running; then
        echo -e "${GREEN}📜 Proxy log (Ctrl+C to stop following):${NC}"
        if [ "$use_color" = 1 ]; then
            tail -n 30 -f "$logfile" | colorize_log
        else
            tail -n 30 -f "$logfile"
        fi
    else
        echo -e "${YELLOW}ℹ️  Proxy is not running — showing the last lines:${NC}"
        if [ "$use_color" = 1 ]; then
            tail -n 30 "$logfile" | colorize_log
        else
            tail -n 30 "$logfile"
        fi
    fi
}

# ----------------------------------------------------------------------------
# set_port — save the listening port
#   Args: $1 = port number (1-65535)
# ----------------------------------------------------------------------------
set_port() {
    if ! is_valid_port "${1:-}"; then
        echo -e "${RED}❌ Invalid port: '${1:-}' (must be a number from 1 to 65535)${NC}"
        exit 1
    fi
    save_port "$1"
    echo -e "${GREEN}✅ Port set to $1.${NC}"
    if is_running; then
        echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy stop && socks5-proxy).${NC}"
    fi
}

# ----------------------------------------------------------------------------
# set_ip — save the listening IP address
#   Args: $1 = IPv4 address (0.0.0.0 = all interfaces)
# ----------------------------------------------------------------------------
set_ip() {
    if ! is_valid_ip "${1:-}"; then
        echo -e "${RED}❌ Invalid IP address: '${1:-}'${NC}"
        exit 1
    fi
    save_ip "$1"
    echo -e "${GREEN}✅ Listen IP set to $1.${NC}"
    if is_running; then
        echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy stop && socks5-proxy).${NC}"
    fi
}

# ----------------------------------------------------------------------------
# set_idle — save the idle timeout in seconds
#   Args: $1 = seconds (10 or more)
# ----------------------------------------------------------------------------
set_idle() {
    if ! [[ "${1:-}" =~ ^[0-9]+$ ]] || [ "${1:-}" -lt 10 ]; then
        echo -e "${RED}❌ Invalid idle timeout: '${1:-}' (must be a number of 10 or more seconds)${NC}"
        exit 1
    fi
    save_config "IDLE_TIMEOUT" "$1"
    echo -e "${GREEN}✅ Idle timeout set to $1 seconds.${NC}"
    echo -e "${YELLOW}ℹ️  Connections with no traffic for that long will be closed.${NC}"
    if is_running; then
        echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy restart).${NC}"
    fi
}

# ----------------------------------------------------------------------------
# set_maxconns — save the maximum simultaneous connections
#   Args: $1 = connection count (1-65535)
# ----------------------------------------------------------------------------
set_maxconns() {
    if ! [[ "${1:-}" =~ ^[0-9]+$ ]] || [ "${1:-}" -lt 1 ] || [ "${1:-}" -gt 65535 ]; then
        echo -e "${RED}❌ Invalid connection limit: '${1:-}' (must be a number from 1 to 65535)${NC}"
        exit 1
    fi
    save_config "MAX_CONNS" "$1"
    echo -e "${GREEN}✅ Max connections set to $1.${NC}"
    if is_running; then
        echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy restart).${NC}"
    fi
}

# ----------------------------------------------------------------------------
# set_loglevel — save the log verbosity
#   Args: $1 = one of debug, info, warning, error
# ----------------------------------------------------------------------------
set_loglevel() {
    case "${1:-}" in
        debug|info|warning|error) ;;
        *)
            echo -e "${RED}❌ Invalid log level: '${1:-}' (use debug, info, warning, or error)${NC}"
            exit 1
            ;;
    esac
    save_config "LOG_LEVEL" "$1"
    echo -e "${GREEN}✅ Log level set to $1.${NC}"
    if is_running; then
        echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy restart).${NC}"
    fi
}

# ----------------------------------------------------------------------------
# set_auth — enable username/password authentication (RFC 1929)
#   Args: $1 = username, $2 = password (optional — prompted hidden if omitted,
#         so the password never appears in `ps` output or shell history)
# ----------------------------------------------------------------------------
set_auth() {
    local user="${1:-}" pass="${2:-}"
    if [ -z "$user" ]; then
        echo -e "${RED}❌ Usage: socks5-proxy set auth <username> [password]${NC}"
        echo -e "${YELLOW}   If you omit the password you will be prompted for it.${NC}"
        exit 1
    fi
    if [ -z "$pass" ]; then
        read -s -p "Password: " pass
        echo   # newline after the hidden input
        if [ -z "$pass" ]; then
            echo -e "${RED}❌ Password cannot be empty.${NC}"
            exit 1
        fi
    fi
    save_config "PROXY_USER" "$user"
    save_config "PROXY_PASS" "$pass"
    echo -e "${GREEN}✅ Authentication enabled (user: $user).${NC}"
    echo -e "${YELLOW}ℹ️  Credentials are stored in plaintext in $CONFIG_FILE (permissions 600).${NC}"
    if is_running; then
        echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy stop && socks5-proxy).${NC}"
    fi
}

# ----------------------------------------------------------------------------
# unset_auth — disable username/password authentication
# ----------------------------------------------------------------------------
unset_auth() {
    remove_config "PROXY_USER"
    remove_config "PROXY_PASS"
    echo -e "${GREEN}✅ Authentication disabled.${NC}"
    if is_running; then
        echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy stop && socks5-proxy).${NC}"
    fi
}

# ----------------------------------------------------------------------------
# show_config — print the saved configuration
# ----------------------------------------------------------------------------
show_config() {
    local user=$(get_stored_user)
    local idle=$(get_stored_idle) maxconns=$(get_stored_maxconns) loglevel=$(get_stored_loglevel)
    echo -e "${YELLOW}📁 Saved configuration:${NC}"
    echo -e "   Port: ${GREEN}$(get_stored_port)${NC}"
    echo -e "   IP:   ${GREEN}$(get_stored_ip)${NC}"
    if [ -n "$user" ]; then
        echo -e "   Auth: ${GREEN}on (user: $user)${NC}"
    else
        echo -e "   Auth: ${YELLOW}off${NC}"
    fi
    echo -e "   Idle timeout: ${GREEN}${idle:-600}s${NC}   Max conns: ${GREEN}${maxconns:-256}${NC}"
    echo -e "   Log level: ${GREEN}${loglevel:-warning}${NC}"
}

# =============================================================================
# Command dispatch
# =============================================================================

CMD="${1:-start}"

case "$CMD" in
    start)
        start_proxy "$2"
        ;;
    stop)
        stop_proxy
        ;;
    restart)
        stop_proxy -q
        start_proxy "$2"
        ;;
    reset)
        # Restart with fresh traffic counters (they live in the server's
        # memory, so a restart is what actually zeroes them). The message is
        # printed before start_proxy, whose interactive `wait` would otherwise
        # delay it until Ctrl+C.
        stop_proxy -q
        rm -f "$CONFIG_DIR/conns" "$CONFIG_DIR/stats"
        echo -e "${YELLOW}ℹ️  Traffic counters cleared.${NC}"
        start_proxy "$2"
        ;;
    status)
        case "${2:-}" in
            -w|--watch) show_status_watch "${3:-}" ;;
            "")        show_status ;;
            *)
                echo -e "${RED}❌ Usage: socks5-proxy status [--watch [<interval-secs>]]${NC}"
                exit 1
                ;;
        esac
        ;;
    logs)
        show_logs "$2"
        ;;
    version|-V|--version)
        echo -e "socks5-proxy ${GREEN}v$VERSION${NC}"
        ;;
    set)
        case "${2:-}" in
            port)    set_port "${3:-}" ;;
            ip)      set_ip "${3:-}" ;;
            auth)    set_auth "${3:-}" "${4:-}" ;;
            idle)    set_idle "${3:-}" ;;
            maxconns) set_maxconns "${3:-}" ;;
            loglevel) set_loglevel "${3:-}" ;;
            *)
                echo -e "${RED}❌ Usage: socks5-proxy set {port <1-65535>|ip <IP>|auth <user> <pass>|idle <secs>|maxconns <n>|loglevel <debug|info|warning|error>}${NC}"
                exit 1
                ;;
        esac
        ;;
    unset)
        case "${2:-}" in
            auth)
                unset_auth
                ;;
            idle)
                remove_config "IDLE_TIMEOUT"
                echo -e "${GREEN}✅ Idle timeout reset to the default (600s).${NC}"
                if is_running; then
                    echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy restart).${NC}"
                fi
                ;;
            maxconns)
                remove_config "MAX_CONNS"
                echo -e "${GREEN}✅ Max connections reset to the default (256).${NC}"
                if is_running; then
                    echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy restart).${NC}"
                fi
                ;;
            loglevel)
                remove_config "LOG_LEVEL"
                echo -e "${GREEN}✅ Log level reset to the default (warning).${NC}"
                if is_running; then
                    echo -e "${YELLOW}ℹ️  Proxy is running — restart to apply (socks5-proxy restart).${NC}"
                fi
                ;;
            *)
                echo -e "${RED}❌ Usage: socks5-proxy unset {auth|idle|maxconns|loglevel}${NC}"
                exit 1
                ;;
        esac
        ;;
    show)
        if [ "${2:-}" = "config" ]; then
            show_config
        else
            echo -e "${RED}❌ Usage: socks5-proxy show config${NC}"
            exit 1
        fi
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        # A plain number is a shortcut for `socks5-proxy start <PORT>`
        if is_valid_port "$CMD"; then
            start_proxy "$CMD"
        else
            echo -e "${RED}❌ Unknown command: '$CMD'${NC}"
            usage
            exit 1
        fi
        ;;
esac
